# --- Database -------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
NODE_ENV="development"
APP_NAME="HOKK Product Operations"
APP_URL="http://localhost:3000"
# Hosts allowed to submit forms when the app is served behind a proxy whose
# Origin differs from the Host header Next sees. Without this, Next.js aborts
# every Server Action with "Invalid Server Actions request." — which breaks
# login, not just uploads. Comma-separated bare hosts or *.domain patterns
# (no protocol). Defaults to *.e2b.app; set your real domain in production.
ALLOWED_ORIGINS="*.e2b.app"
# Base URL used to build publicly-reachable image URLs for Shopify imports.
# Leave blank to keep image export disabled (the export will warn explicitly).
PUBLIC_BASE_URL=""

# --- Auth -----------------------------------------------------------------
# 32+ random chars. Regenerate for production.
SESSION_SECRET="hokk-dev-session-secret-change-me-0123456789"

# --- Initial super admin (used only by `npm run bootstrap`) ---------------
SEED_ADMIN_EMAIL="founder@houseofkalakatha.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Vishal Patwari"

# --- Storage --------------------------------------------------------------
# LOCAL | GDRIVE
STORAGE_BACKEND="LOCAL"
UPLOAD_DIR="storage/uploads"
MAX_IMAGE_BYTES="15728640"
MIN_IMAGE_BYTES="20480"

# --- Google Drive (used when STORAGE_BACKEND=GDRIVE) ---------------------
# Option A (recommended for servers): service-account JSON, base64 or a path.
GDRIVE_SERVICE_ACCOUNT_JSON=""
GDRIVE_SERVICE_ACCOUNT_FILE=""
# Option B: OAuth refresh token flow
GDRIVE_CLIENT_ID=""
GDRIVE_CLIENT_SECRET=""
GDRIVE_REFRESH_TOKEN=""
# Shared parent folder id under which "Original" and "Final" are created.
GDRIVE_PARENT_FOLDER_ID=""
GDRIVE_ORIGINAL_FOLDER_ID=""
GDRIVE_FINAL_FOLDER_ID=""
GDRIVE_PUBLIC_URL_TEMPLATE="https://lh3.googleusercontent.com/d/{fileId}"

# --- Shopify --------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_VENDOR="House of Kala Katha"
SHOPIFY_DEFAULT_STATUS="draft"
SHOPIFY_PUBLISHED="FALSE"
