# --- Database -------------------------------------------------------------
# Local development: any path you like. On Render use the persistent disk:
#   DATABASE_URL="file:/var/data/hokk.db"      (RENDER.md)
# Shared online database (recommended for teams — every device sees the same
# products, users and settings): free Turso database — see CLOUD_STORAGE.md:
#   DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
#   TURSO_AUTH_TOKEN="<token from turso>"   (or LIBSQL_AUTH_TOKEN)
DATABASE_URL="file:./dev.db"

# --- App ------------------------------------------------------------------
NODE_ENV="development"
APP_NAME="HOKK Product Operations"
APP_URL="http://localhost:3000"
# Hosts allowed to submit forms when the app is served behind a proxy whose
# Origin differs from the Host header Next sees. Without this, Next.js aborts
# every Server Action with "Invalid Server Actions request." — which breaks
# login, not just uploads. Comma-separated bare hosts or *.domain patterns
# (no protocol). Defaults to *.e2b.app; set your real domain in production.
ALLOWED_ORIGINS="*.e2b.app"
# Optional override used to build publicly-reachable image URLs for Shopify.
# Leave blank to use the current request host automatically (works behind
# Render, Vercel and reverse proxies); set it only to force a custom domain.
PUBLIC_BASE_URL=""

# --- Auth -----------------------------------------------------------------
# 32+ random chars. Regenerate for production.
SESSION_SECRET="hokk-dev-session-secret-change-me-0123456789"

# --- Initial super admin (used only by `npm run bootstrap`) ---------------
SEED_ADMIN_EMAIL="founder@houseofkalakatha.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Vishal Patwari"

# --- Storage ------------------------------------------------------------
# Where uploaded photographs go: LOCAL (this machine's disk) or CLOUDINARY
# (one shared online copy, viewable from every device the moment an upload
# finishes). This env var wins when set; otherwise Settings → Storage decides.
# Full walkthrough: CLOUD_STORAGE.md.
STORAGE_BACKEND="LOCAL"

# Local disk: where files are written. On Render put this on the persistent
# disk — /var/data/storage/uploads (the app defaults to that path on Render).
# Files are served publicly at /api/media/<key>.
UPLOAD_DIR="storage/uploads"
MAX_IMAGE_BYTES="15728640"
MIN_IMAGE_BYTES="20480"

# --- Cloudinary (free tier, no credit card) --------------------------------
# Sign up at https://cloudinary.com, open the Dashboard and copy the three
# values. Then set STORAGE_BACKEND="CLOUDINARY" above (or switch in Settings →
# Storage) and restart the app.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional folder prefix for uploaded assets (default: hokk-pos).
CLOUDINARY_FOLDER="hokk-pos"

# --- Render.com -----------------------------------------------------------
# render.yaml in the repository root already sets everything below; these are
# documented here so a manual setup matches. Full walkthrough: RENDER.md.
# RENDER=true                    # injected by Render
# RENDER_EXTERNAL_HOSTNAME=<service>.onrender.com      # injected by Render
# RENDER_DISK_MOUNT=/var/data    # only if the disk is mounted elsewhere
# EXPORT_DIR=/var/data/storage/exports
# ALLOW_EPHEMERAL_STORAGE=1      # start without a disk (all data lost on deploy)

# --- Shopify --------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_VENDOR="House of Kala Katha"
SHOPIFY_DEFAULT_STATUS="draft"
SHOPIFY_PUBLISHED="FALSE"
