{
  "name": "hokk-pos",
  "version": "0.1.0",
  "private": true,
  "description": "House of Kala Katha — Product Operations System (master catalog, content, photography & Shopify bulk export platform)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/db-init.ts",
    "bootstrap": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/bootstrap.ts",
    "e2e": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/e2e.ts",
    "drive:setup": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/setup-drive-structure.ts",
    "drive:verify": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/verify-gdrive.ts",
    "drive:doctor": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/diagnose-oauth.ts",
    "drive:authorize": "tsx --tsconfig scripts/tsconfig.json scripts/oauth-authorize.ts",
    "s3:verify": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/verify-s3.ts",
    "render:verify": "tsx --env-file-if-exists=.env --tsconfig scripts/tsconfig.json scripts/verify-render.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "libsql": "^0.5.29",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
